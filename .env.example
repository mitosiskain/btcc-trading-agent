# Gemini AI (for Sentiment & Catalyst Analyst + Google Search Grounding + Backtest Researcher)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Alerts (Phone notifications for Entries + Profit-Flatline Stall Exits)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# High-Leverage Isolated Margin & Deep Account Reserve Settings
ACCOUNT_BALANCE_USD=10000.0
MARGIN_PER_TRADE_USD=100.0
DEFAULT_LEVERAGE=100

# BTCC Exchange API (Keep LIVE_TRADING_ENABLED=false for full-auto simulation/testing)
LIVE_TRADING_ENABLED=false
BTCC_API_KEY=
BTCC_API_SECRET=
